 /* scroll-fade */
+/*
+ * Without scroll-driven animations (Firefox), there is no telling how far a
+ * scroller is scrolled, so no edge fades: every --scroll-fade-* edge stays at
+ * its initial 0px. Fading every edge regardless would dim the first item of a
+ * list that is at its top, and the last of one at its bottom.
+ */
 @property --scroll-fade-t {
 	syntax: "<length-percentage>";
 	inherits: false;
