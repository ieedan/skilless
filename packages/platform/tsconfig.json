{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"allowJs": true,
		"types": ["node"]
	},
	"include": ["convex/**/*.ts", "src/**/*.ts", "env.convex.ts"],
	"exclude": ["node_modules"]
}
