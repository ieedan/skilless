{
	"name": "skilless",
	"description": "Author skills once, sync them everywhere, install them per project.",
	"version": "0.0.9",
	"license": "MIT",
	"homepage": "https://skilless.dev",
	"author": {
		"name": "Aidan Bleser",
		"url": "https://github.com/ieedan"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/skilless",
		"directory": "packages/skilless"
	},
	"keywords": [
		"skills",
		"agents",
		"claude",
		"ai",
		"cli"
	],
	"type": "module",
	"bin": "./dist/bin.mjs",
	"files": [
		"dist/**/*",
		"!dist/**/*.map"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"start": "node ./dist/bin.mjs",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check": "tsc --noEmit",
		"prepublishOnly": "pnpm build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"commander": "catalog:",
		"enquirer": "^2.4.1",
		"ora": "^9.4.1",
		"pathe": "catalog:",
		"picocolors": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
