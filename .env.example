# Convex deployment (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# Shared secret the Hono API uses to reach Convex as a trusted server
FUNCTION_SECRET=

# better-auth
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:5173

# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Skill file storage (Cloudflare R2). R2_PUBLIC_URL is the bucket's public r2.dev URL
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
